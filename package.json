{
  "name": "heaven-bespoke-studio",
  "version": "1.0.0",
  "description": "A conversion-focused furniture studio experience for the RacDox 2026 hackathon. Built for Heaven Furniture Mart, Chattogram.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "prettier --check src scripts/*.mjs \"*.{json,js,ts,html}\" docs/*.md README.md",
    "assets:optimize": "node scripts/optimize_assets.mjs",
    "assets:materials": "node scripts/render_materials.mjs",
    "gpu:check": "vgpu check src/shaders/material.wgsl --require-validation"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Seyamalam/heaven-bespoke-studio.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Seyamalam/heaven-bespoke-studio/issues"
  },
  "homepage": "https://github.com/Seyamalam/heaven-bespoke-studio#readme",
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "vgpu": "^0.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "private": true
}
